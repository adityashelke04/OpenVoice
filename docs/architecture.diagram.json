  "cards": [
    {
      "dot": "cyan",
      "title": "The boundary",
      "items": [
        "ov-core and ov-format carry no OS, IO, GUI or async-runtime dependency",
        "CI compiles both for wasm32-unknown-unknown, so a leak turns the build red",
        "Six port traits are the entire contract surface; a seventh needs an ADR"
      ]
    },
    {
      "dot": "emerald",
      "title": "The hot path",
      "items": [
        "The composition root feeds Input in and executes every Effect that comes back",
        "Parakeet TDT 0.6b v2 decodes in this process, statically linked, no DLLs",
        "Short text goes out as Unicode keystrokes, long text as a restored clipboard paste"
      ]
    },
    {
      "dot": "rose",
      "title": "Local-first",
      "items": [
        "ov-fetch is the only crate in the workspace that can open a socket",
        "Weights arrive only on a user-initiated download, verified by sha256",
        "History lives in bundled SQLite with FTS5; audio is never written to disk"
      ]
    }
  ]
