{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenVoice",
  "version": "0.1.0",
  "identifier": "ai.openvoice.desktop",
  "build": {
    "frontendDist": "../../apps/ui/dist",
    "devUrl": "http://localhost:5199",
    "beforeDevCommand": "npm --prefix ../../apps/ui run dev -- --port 5199 --strictPort",
    "beforeBuildCommand": "npm --prefix ../../apps/ui run build"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost ws://localhost:5199 http://localhost:5199"
    },
    "windows": [
      {
        "label": "hub",
        "title": "OpenVoice",
        "url": "index.html?window=hub",
        "width": 1060,
        "height": 720,
        "minWidth": 860,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "decorations": true,
        "theme": "Dark",
        "backgroundColor": "#000000",
        "visible": true
      },
      {
        "label": "overlay",
        "url": "index.html?window=overlay",
        "width": 280,
        "height": 52,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false,
        "acceptFirstMouse": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Local-first voice dictation",
    "longDescription": "Hold a key, speak, and your words appear wherever your cursor is. Runs entirely on your machine — no cloud, no account, no telemetry."
  }
}
